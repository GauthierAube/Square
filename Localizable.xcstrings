      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Green Button"
          }
        }
      }
    },
    "Le bouton vert remplit l'écran": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The green button fills the screen"
          }
        }
      }
    },
    "Les applications rangées dans le tiroir du bas de Side gardent leur place dans le tiroir : Square ne les agrandit pas. Leur liste se règle dans Side (Réglages > Tiroir du bas).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps kept in Side's bottom drawer stay in the drawer: Square doesn't make them fill the screen. Set the list in Side (Settings > Bottom Drawer)."
          }
        }
      }
    },
    "Les cartes suivent les doigts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards follow fingers"
          }
        }
      }
    },
